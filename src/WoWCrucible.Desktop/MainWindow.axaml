<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:WoWCrucible.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="WoWCrucible.Desktop.MainWindow"
        Title="WoW Crucible"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootLayout" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="260,Auto,*,Auto,340">
        <local:WorkspaceRuntimeStrip x:Name="RuntimeStrip" Grid.Row="0" Grid.ColumnSpan="5" />
        <Grid Grid.Row="1" Grid.ColumnSpan="5" ColumnDefinitions="Auto,*,Auto" Background="#10151E">
            <ToggleButton x:Name="ToolsPaneToggle" Content="Tools" Margin="6,3" Click="ToggleNavigationPaneClick" ToolTip.Tip="Show or hide the tool browser" />
            <local:WorkspaceTabStrip x:Name="WorkspaceTabs" Grid.Column="1" />
            <Button x:Name="LayoutButton" Grid.Column="2" Content="Layout ▾" Margin="6,3" />
        </Grid>
        <Border x:Name="MainHeader" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Background="#191B1E" BorderBrush="#36393E" BorderThickness="0,0,0,1">
            <StackPanel Margin="8,4" Spacing="4">
                <WrapPanel Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Content="Open DBC / DB2" Click="OpenDbcClick" ToolTip.Tip="Open DBC or DB2 files (Ctrl+O)" />
                    <WrapPanel x:Name="DbcQuickActions" IsVisible="False">
                        <Button Margin="0,0,6,0" Content="Save" Click="SaveClick" ToolTip.Tip="Save (Ctrl+S)" />
                        <Button Margin="0,0,6,0" Content="Save As…" Click="SaveAsClick" ToolTip.Tip="Save As (Ctrl+Shift+S)" />
                        <Button Margin="0,0,12,0" Content="×" Click="CloseDocumentClick" AutomationProperties.Name="Close current file" ToolTip.Tip="Close current file (Ctrl+W)" />
                    </WrapPanel>
                    <ToggleButton x:Name="DetailsPaneToggle" Margin="0,0,6,0" Content="Row editor" Click="ToggleInspectorPaneClick" ToolTip.Tip="Show or hide the selected record" />
                    <Button Content="Commands…" Click="OpenCommandPaletteClick" ToolTip.Tip="All commands (Ctrl+K)" />
                </WrapPanel>
                <StackPanel x:Name="FindReplaceBar" IsVisible="False" Spacing="4">
                    <WrapPanel Orientation="Horizontal">
                        <TextBox x:Name="SearchBox" Width="260" Margin="0,0,4,0" PlaceholderText="Filter records…" AutomationProperties.Name="Filter records" TextChanged="SearchChanged" />
                        <Button Margin="0,0,4,0" Content="×" Click="ClearFilterClick" AutomationProperties.Name="Clear filter" ToolTip.Tip="Clear filter" />
                        <Button Margin="0,0,4,0" Content="↑" Click="FindPreviousClick" AutomationProperties.Name="Previous match" ToolTip.Tip="Previous matching cell (Shift+Enter)" />
                        <Button Margin="0,0,6,0" Content="↓" Click="FindNextClick" AutomationProperties.Name="Next match" ToolTip.Tip="Next matching cell (Enter)" />
                        <ToggleButton x:Name="ReplaceToggle" Margin="0,0,16,0" Content="Replace" Click="ToggleReplaceClick" ToolTip.Tip="Find and replace (Ctrl+H)" />
                        <TextBox x:Name="GoToIdBox" Width="125" Margin="0,0,4,0" PlaceholderText="Record ID" AutomationProperties.Name="Record ID" KeyDown="GoToIdKeyDown" />
                        <Button x:Name="GoToIdButton" Content="Go to ID" Click="GoToIdClick" />
                    </WrapPanel>
                    <WrapPanel x:Name="ReplaceControls" IsVisible="False" Orientation="Horizontal">
                        <TextBox x:Name="ReplaceBox" Width="260" Margin="0,0,6,0" PlaceholderText="Replace with…" />
                        <Button x:Name="ReplaceOneButton" Margin="0,0,4,0" Content="Replace next" Click="ReplaceOneClick" />
                        <Button x:Name="ReplaceAllButton" Margin="0,0,4,0" Content="Replace all…" Click="ReplaceAllClick" />
                        <Button Content="×" Click="CloseFindReplaceClick" AutomationProperties.Name="Close replace" ToolTip.Tip="Close replace" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="FeatureToolbarHost" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" IsVisible="False" Padding="8,4" Background="#111722" />
        <Border x:Name="NavigationPane" Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" BorderBrush="#2B3445" BorderThickness="0,0,1,0" Background="#0E1219">
            <Grid RowDefinitions="Auto,*,Auto" Margin="10">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="TOOLS" Foreground="#AEB8C9" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Padding="7,3" Click="ToggleNavigationPaneClick" AutomationProperties.Name="Close tool browser" ToolTip.Tip="Reopen from Layout or the Tools button." />
                </Grid>
                <local:WorkspaceNavigator x:Name="ToolBrowser" Grid.Row="1" />
                <Expander Grid.Row="2" Header="Diagnostics" Margin="0,8,0,0">
                    <StackPanel Spacing="5">
                        <ToggleSwitch x:Name="DevbugModeToggle" OnContent="Devbug on" OffContent="Devbug off" IsCheckedChanged="DevbugModeChanged" />
                        <TextBlock x:Name="BuildIdentityText" Foreground="#7F8A9F" FontSize="10" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <GridSplitter x:Name="NavigationSplitter" Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" ResizeDirection="Columns" Background="#2B3445" />

        <Grid x:Name="EditorWorkspace" Grid.Row="3" Grid.Column="2" RowDefinitions="Auto,*" Background="#090C11">
            <Border x:Name="DbcDocumentToolbar" IsVisible="False" BorderBrush="#2B3445" BorderThickness="0,0,0,1" Background="#0E131C">
                <Grid RowDefinitions="Auto,Auto">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DocumentTabsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel Margin="6,4" Orientation="Horizontal">
                            <Button Margin="0,0,4,0" Content="↶" Padding="8,4" Click="UndoClick" AutomationProperties.Name="Undo" ToolTip.Tip="Undo (Ctrl+Z)" />
                            <Button Margin="0,0,4,0" Content="↷" Padding="8,4" Click="RedoClick" AutomationProperties.Name="Redo" ToolTip.Tip="Redo (Ctrl+Y)" />
                            <Button Margin="0,0,4,0" Content="Add row" Padding="8,4" Click="AddRowClick" />
                            <Button Margin="0,0,4,0" Content="Clone" Padding="8,4" Click="CloneRowClick" />
                            <Button Margin="0,0,4,0" Content="Clone ×…" Padding="8,4" Click="CloneMultipleClick" />
                            <Button Margin="0,0,4,0" Content="Delete" Padding="8,4" Click="DeleteRowClick" />
                            <ToggleButton x:Name="SplitDbcToggle" Margin="0,0,4,0" Content="Split" Padding="8,4" Click="SplitDbcClick" ToolTip.Tip="Show two staged DBC tabs side by side. Click a pane, then click a tab to load it there." />
                            <Button Margin="0,0,4,0" Content="Spell workspace" Padding="8,4" Click="OpenSpellWorkspaceClick" />
                            <Button Margin="0,0,4,0" Content="Staging database" Padding="8,4" Click="OpenDbcStagingClick" />
                            <ToggleSwitch x:Name="DecodedToggle" OnContent="Decoded" OffContent="Raw" IsChecked="True" Margin="4,0" IsCheckedChanged="DecodedChanged" />
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid x:Name="WelcomePanel">
                    <local:WorkspaceStartPage x:Name="StartPage" />
                    <StackPanel x:Name="TableStartPanel" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24">
                        <TextBlock Text="Client data tables" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Open a DBC / DB2 to inspect or edit its records." Foreground="#AEB8C9" TextWrapping="Wrap" />
                        <Button Content="Open DBC / DB2…" Click="OpenDbcClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="DbcHost" IsVisible="False" ColumnDefinitions="*,Auto,0*">
                    <Border x:Name="PrimaryDbcPane" BorderBrush="#C58A2B" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="PrimaryDbcPaneTitle" Grid.ColumnSpan="2" Margin="8,4" Foreground="#AEB8C9" FontSize="10" Text="PRIMARY" />
                            <local:VirtualDbcView x:Name="DbcView" Grid.Row="1" />
                            <TextBox x:Name="DbcInlineEditor"
                                     Grid.Row="1"
                                     IsVisible="False"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Padding="7,1"
                                     FontFamily="Inter"
                                     FontSize="13"
                                     Background="#0A0F17"
                                     BorderBrush="#E0A33C"
                                     BorderThickness="2" />
                            <ScrollBar x:Name="VerticalDbcScroll" Grid.Row="1" Grid.Column="1" Orientation="Vertical" SmallChange="27" LargeChange="500" ValueChanged="DbcScrollChanged" />
                            <ScrollBar x:Name="HorizontalDbcScroll" Grid.Row="2" Orientation="Horizontal" SmallChange="156" LargeChange="624" ValueChanged="DbcScrollChanged" />
                        </Grid>
                    </Border>
                    <GridSplitter x:Name="DbcSplitDivider" Grid.Column="1" IsVisible="False" ResizeDirection="Columns" Background="#39455A" />
                    <Border x:Name="SecondaryDbcPane" Grid.Column="2" IsVisible="False" BorderBrush="#39455A" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SecondaryDbcPaneTitle" Grid.ColumnSpan="2" Margin="8,4" Foreground="#AEB8C9" FontSize="10" Text="SECONDARY" />
                            <local:VirtualDbcView x:Name="SecondaryDbcView" Grid.Row="1" />
                            <TextBox x:Name="SecondaryDbcInlineEditor"
                                     Grid.Row="1"
                                     IsVisible="False"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Padding="7,1"
                                     FontFamily="Inter"
                                     FontSize="13"
                                     Background="#0A0F17"
                                     BorderBrush="#E0A33C"
                                     BorderThickness="2" />
                            <ScrollBar x:Name="SecondaryVerticalDbcScroll" Grid.Row="1" Grid.Column="1" Orientation="Vertical" SmallChange="27" LargeChange="500" ValueChanged="SecondaryDbcScrollChanged" />
                            <ScrollBar x:Name="SecondaryHorizontalDbcScroll" Grid.Row="2" Orientation="Horizontal" SmallChange="156" LargeChange="624" ValueChanged="SecondaryDbcScrollChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <GridSplitter x:Name="InspectorSplitter" Grid.Row="3" Grid.Column="3" ResizeDirection="Columns" Background="#2B3445" />

        <Border x:Name="InspectorPane" Grid.Row="3" Grid.Column="4" BorderBrush="#36393E" BorderThickness="1,0,0,0" Background="#1B1D20">
            <TabControl x:Name="InspectorTabs">
                <TabItem x:Name="RowEditorTab" Header="Row" FontSize="14">
                    <local:DbcRowEditorView x:Name="RowEditor" />
                </TabItem>
                <TabItem Header="Details" FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12" Spacing="12">
                            <TextBlock x:Name="InspectorTitle" Text="Nothing selected" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="InspectorSummary" Text="No file open" TextWrapping="Wrap" Foreground="#B0B5BC" />
                            <TextBlock x:Name="InspectorDetail" TextWrapping="Wrap" Foreground="#939AA4" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border x:Name="MainStatusBar" Grid.Row="4" Grid.ColumnSpan="5" BorderBrush="#2B3445" BorderThickness="0,1,0,0" Background="#0B0F16">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="#98A2B4" FontSize="11" />
                <TextBlock x:Name="RenderText" Grid.Column="1" Text="Viewport idle" VerticalAlignment="Center" Foreground="#758197" FontSize="11" />
            </Grid>
        </Border>

        <Border x:Name="FeatureWorkspaceHost" Grid.Row="3" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="3" IsVisible="False" Background="#090C11" />
        <Grid x:Name="CommandPaletteHost" Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="5" IsVisible="False" Background="#B805070A" ColumnDefinitions="*,4*,*" RowDefinitions="*,6*,*">
            <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="10" BorderBrush="#4A5A76" BorderThickness="1" Background="#111722">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="COMMAND PALETTE" Foreground="#C58A2B" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Search every native workspace and common action" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close · Esc" Click="CloseCommandPaletteClick" />
                    </Grid>
                    <TextBox x:Name="CommandPaletteSearch" Grid.Row="1" PlaceholderText="Try: cut items, Heidi favorites, MPQ merge, model viewer, server restart…" />
                    <Grid Grid.Row="2">
                        <ListBox x:Name="CommandPaletteResults" HorizontalAlignment="Stretch" Background="#0A0E15" BorderBrush="#283247" BorderThickness="1" />
                        <TextBlock x:Name="CommandPaletteEmptyText" Text="No command matches every search term." IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8793A7" />
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="CommandPaletteStatus" Foreground="#8793A7" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="↑↓ select · Enter open · Esc close" Foreground="#8793A7" FontSize="11" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="DialogOverlayHost" Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="5" IsVisible="False" Background="#CC05070A" ColumnDefinitions="*,4*,*" RowDefinitions="*,8*,*">
            <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="10" BorderBrush="#39465E" BorderThickness="1" Background="#111722">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ContentControl x:Name="DialogContent" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
